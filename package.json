{
  "name": "@quincarter/document-viewer",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Quin Carter <quin.carter@gmail.com>",
  "keywords": [
    "web-component",
    "lit",
    "pdf",
    "epub",
    "viewer",
    "document-viewer"
  ],
  "description": "A document viewer for PDF and EPUB files, built with Lit and Vite.",
  "repository": {
    "type": "git",
    "url": "https://github.com/quincarter/document-viewer-web-component.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "rimraf lib && vite build",
    "build:demo": "vite build --mode demo",
    "deploy": "yarn build:demo && yarn gh-pages -d ./dist",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:wtr": "web-test-runner",
    "test:wtr:watch": "web-test-runner --watch",
    "changeset:add": "changeset add && changeset version"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.12",
    "@quincarter/document-viewer": "^0.1.0",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@changesets/cli": "^2.30.0",
    "@open-wc/testing": "^4.0.0",
    "@types/gh-pages": "^6",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.8.3",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.13.0"
}
