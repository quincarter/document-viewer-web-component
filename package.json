{
	"name": "@quincarter/document-viewer",
	"version": "0.1.5",
	"license": "MIT",
	"author": "Quin Carter <quin.carter@gmail.com>",
	"keywords": [
		"web-component",
		"lit",
		"pdf",
		"epub",
		"viewer",
		"document-viewer"
	],
	"description": "A document viewer for PDF and EPUB files, built with Lit and Vite.",
	"repository": {
		"type": "git",
		"url": "https://github.com/quincarter/document-viewer-web-component.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "lib/index.js",
	"module": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		}
	},
	"files": [
		"lib",
		"README.md"
	],
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"build": "rimraf lib && vite build",
		"build:demo": "vite build --mode demo",
		"deploy": "yarn build:demo && yarn gh-pages -d ./dist",
		"preview": "vite preview",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"changeset:add": "changeset add && changeset version"
	},
	"dependencies": {
		"@hyzyla/pdfium": "^2.1.13",
		"epubjs": "^0.3.93",
		"jszip": "^3.10.1",
		"lit": "^3.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@changesets/cli": "^3.0.1",
		"@types/gh-pages": "^6.1.0",
		"@vitest/coverage-v8": "4.1.11",
		"gh-pages": "^6.3.0",
		"happy-dom": "^20.11.15",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"vite": "^7.3.1",
		"vite-plugin-dts": "^5.0.3",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0",
		"vitest": "^4.1.11"
	},
	"packageManager": "yarn@4.18.0"
}
