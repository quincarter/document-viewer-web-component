{
	"name": "@quincarter/document-viewer",
	"version": "0.0.3",
	"license": "MIT",
	"author": "Quin Carter <quin.carter@gmail.com>",
	"keywords": [
		"web-component",
		"lit",
		"pdf",
		"epub",
		"viewer",
		"document-viewer"
	],
	"description": "A document viewer for PDF and EPUB files, built with Lit and Vite.",
	"repository": {
		"type": "git",
		"url": "https://github.com/quincarter/document-viewer-web-component.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"lib/components",
		"lib/utils",
		"lib/index.js",
		"lib/index.d.ts",
		"lib/index.js.map",
		"README.md"
	],
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"build": "rimraf lib && tsc && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"changeset:add": "changeset add && changeset version"
	},
	"dependencies": {
		"@hyzyla/pdfium": "^2.1.12",
		"epubjs": "^0.3.93",
		"jszip": "^3.10.1",
		"lit": "^3.3.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@changesets/cli": "^2.30.0",
		"rimraf": "^6.1.3",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.5.0"
	},
	"packageManager": "yarn@4.13.0"
}
